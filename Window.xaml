<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼎山打字通 v2.3.2" Width="1160" Height="815" MinWidth="565" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#101C24"
        Foreground="#EDF4F2" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True">
  <Window.Resources>
    <FontFamily x:Key="DisplayFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Accent" Color="#ECF664" />
    <SolidColorBrush x:Key="Text" Color="#EDF4F2" />
    <SolidColorBrush x:Key="Ink" Color="#182015" />
    <SolidColorBrush x:Key="Muted" Color="#B0C7CC" />
    <SolidColorBrush x:Key="Line" Color="#52717B" />
    <SolidColorBrush x:Key="Panel" Color="#E6192A34" />
    <SolidColorBrush x:Key="Field" Color="#101D25" />
    <SolidColorBrush x:Key="Raised" Color="#2B414B" />
    <SolidColorBrush x:Key="Active" Color="#43626C" />
    <SolidColorBrush x:Key="Coral" Color="#FFAA98" />
    <SolidColorBrush x:Key="PracticeCorrect" Color="#A0E0C8" />
    <SolidColorBrush x:Key="PracticeIncorrect" Color="#FFBEB2" />
    <SolidColorBrush x:Key="PracticeIncorrectBackground" Color="#54282F" />
    <SolidColorBrush x:Key="PracticeNextBackground" Color="#535B23" />
    <SolidColorBrush x:Key="WordEchoPrimary" Color="#7ED1EF" />
    <SolidColorBrush x:Key="WordEchoSecondary" Color="#E79AD5" />
    <SolidColorBrush x:Key="BoardBody" Color="#87C264" />
    <SolidColorBrush x:Key="BoardSurface" Color="#101E27" />
    <SolidColorBrush x:Key="BoardCurrent" Color="#313F2A" />
    <SolidColorBrush x:Key="BoardQuiet" Color="#9EB5BC" />
    <SolidColorBrush x:Key="BoardLabel" Color="#E4F4ED" />
    <SolidColorBrush x:Key="BoardStar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BoardGrid" Color="#354B55" />
    <SolidColorBrush x:Key="BoardBubble" Color="#1E313A" />
    <SolidColorBrush x:Key="BoardOuter" Color="#091017" />
    <SolidColorBrush x:Key="BoardClosed" Color="#2F3A42" />
    <SolidColorBrush x:Key="BoardObstacle" Color="#5D767F" />
    <SolidColorBrush x:Key="BoardObstacleLine" Color="#99ADB2" />
    <SolidColorBrush x:Key="BoardGreenLand" Color="#24402F" />
    <SolidColorBrush x:Key="BoardBlueLand" Color="#223E53" />
    <SolidColorBrush x:Key="BoardPurpleLand" Color="#3F2E4E" />
    <SolidColorBrush x:Key="BoardGoldLand" Color="#4B3C26" />
    <SolidColorBrush x:Key="BoardBluePlayer" Color="#67BDEF" />
    <SolidColorBrush x:Key="BoardPurplePlayer" Color="#D192F1" />
    <SolidColorBrush x:Key="BoardGoldPlayer" Color="#F7C15D" />
    <LinearGradientBrush x:Key="Backplate" StartPoint="0,1" EndPoint="1,0">
      <GradientStop Color="#0B1218" Offset="0" />
      <GradientStop Color="#14252E" Offset=".54" />
      <GradientStop Color="#3E626B" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="GuideGrid" TileMode="Tile" Viewport="0,0,92,92" ViewportUnits="Absolute" Stretch="Fill">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H92 V92 H0 Z" />
          <GeometryDrawing Geometry="M0,0 H92 M0,0 V92">
            <GeometryDrawing.Pen><Pen Brush="#265E9097" Thickness="1" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#677DABB1" Geometry="M0,0 H2 V2 H0 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="Halftone" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H12 V12 H0 Z" />
          <GeometryDrawing Brush="#6783B5BC">
            <GeometryDrawing.Geometry><GeometryGroup>
              <EllipseGeometry Center="3,3" RadiusX="1.9" RadiusY="1.9" />
              <EllipseGeometry Center="9,9" RadiusX="1.9" RadiusY="1.9" />
            </GeometryGroup></GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="Rivets" TileMode="Tile" Viewport="0,0,34,34" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H34 V34 H0 Z" />
          <GeometryDrawing Brush="{StaticResource Line}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="6,6" RadiusX="2.2" RadiusY="2.2" /></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M5,7 L7,5">
            <GeometryDrawing.Pen><Pen Brush="{StaticResource Field}" Thickness=".75" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style x:Key="DisplayTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="38" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ControlFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="2" BorderBrush="{StaticResource Accent}" BorderThickness="1" IsHitTestVisible="False" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Chrome" Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" />
              <Border x:Name="Contact" Background="#00D9FFFF" IsHitTestVisible="False" />
              <Path x:Name="Notch" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                    Fill="{StaticResource Field}" Data="M0,0 H8 V8 Z" IsHitTestVisible="False" />
              <Border x:Name="ActivationEdge" Height="2" Margin="1,0,1,1" VerticalAlignment="Bottom" Background="#F7FFC7"
                      Opacity="0" IsHitTestVisible="False" />
              <ContentPresenter x:Name="Caption" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Contact" Property="Background" Value="#22D9FFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Contact" Property="Background" Value="#48070D10" />
                <Setter TargetName="Caption" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate>
              <Border Margin="3" BorderBrush="{StaticResource Ink}" BorderThickness="1" IsHitTestVisible="False" />
            </ControlTemplate></Setter.Value></Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}" />
      <Setter Property="Padding" Value="5,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent" LastChildFill="True">
              <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0">
                <Border x:Name="Mark" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <Path x:Name="Tick" Visibility="Hidden" Stroke="{StaticResource Ink}" StrokeThickness="2"
                        Data="M2,6 L5,9 L11,3" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <Border x:Name="ActivationEdge" BorderBrush="#F7FFC7" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
              </Grid>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Mark" Property="Opacity" Value=".68" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="Chrome">
              <Border x:Name="Option" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      Background="{StaticResource Field}" Padding="{TemplateBinding Padding}">
                <DockPanel>
                  <Border x:Name="Mark" Width="12" Height="12" Margin="1,0,10,0" VerticalAlignment="Center"
                          BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                    <Ellipse x:Name="Dot" Margin="2" Fill="{StaticResource Accent}" Visibility="Hidden" />
                  </Border>
                  <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                </DockPanel>
              </Border>
              <Border x:Name="ActivationEdge" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                      Opacity="0" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Option" Property="Background" Value="{StaticResource Raised}" />
                <Setter TargetName="Option" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Option" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Option" Property="Opacity" Value=".7" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Active}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Active}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ScrollStep" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11" />
      <Setter Property="MinWidth" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{StaticResource Field}" Padding="2">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollStep}" /></Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="{StaticResource Line}" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollStep}" /></Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="11" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="MinHeight" Value="17" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="3" VerticalAlignment="Center" Background="{StaticResource Line}" />
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"><Border Height="3" VerticalAlignment="Center" Background="{StaticResource Accent}" /></Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="12" Height="15" Cursor="SizeWE">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Path x:Name="CursorMark" Data="M0,0 H7 L10,3 V14 H3 L0,11 Z" Stretch="Fill"
                                Fill="{StaticResource Accent}" Margin="1,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CursorMark" Property="Fill" Value="#F7FFC7" /></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="CursorMark" Property="Fill" Value="#AEB748" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollStep}" /></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource Field}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Entry" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Entry" Property="Background" Value="{StaticResource Raised}" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Entry" Property="Background" Value="{StaticResource Active}" />
                <Setter TargetName="Entry" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"
                    BorderThickness="2,0,0,0" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource Active}" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Raised}">
                      <Path x:Name="Caret" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin=".5,.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Field}" /></Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{StaticResource Active}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter TargetName="Caret" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="9,0,27,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
              <Border x:Name="ActivationEdge" Height="2" Margin="1,0,1,1" VerticalAlignment="Bottom" Background="{StaticResource Accent}"
                      Opacity="0" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     Focusable="False" AllowsTransparency="True">
                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                            FocusVisualStyle="{StaticResource ControlFocus}" Foreground="{TemplateBinding Foreground}"
                            Cursor="Hand" Padding="8,4" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                      <Border x:Name="Plate" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                      <Border x:Name="ActivationEdge" Width="2" HorizontalAlignment="Left" Margin="1" Background="{StaticResource Accent}"
                              Opacity="0" IsHitTestVisible="False" />
                      <DockPanel Margin="{TemplateBinding Padding}">
                        <Path x:Name="Caret" DockPanel.Dock="Right" Margin="7,0,1,0" VerticalAlignment="Center"
                              Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Accent}" StrokeThickness="1.5" RenderTransformOrigin=".5,.5" />
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                      </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value=".68" /></Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Plate" Property="Background" Value="{StaticResource Raised}" />
                        <Setter TargetName="Caret" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Details" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="31" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </Window.Resources>

  <Grid>
  <Grid x:Name="BackgroundLayers" IsHitTestVisible="False">
    <Border Background="{StaticResource Backplate}" />
    <Border x:Name="BackgroundLight">
      <Border.Background>
        <RadialGradientBrush Center=".70,.28" GradientOrigin=".70,.28" RadiusX=".46" RadiusY=".62">
