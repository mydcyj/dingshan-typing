              <TextBlock Text="在这里输入" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="RoundStatus" DockPanel.Dock="Right"
                         Foreground="{StaticResource Muted}" FontSize="13" />
            </DockPanel>
            <TextBox x:Name="Typed" Height="96" Margin="0,8,0,0" Padding="10,7"
                     FontFamily="Consolas" FontSize="22" TextWrapping="Wrap" AcceptsReturn="False"
                     Typography.StandardLigatures="False" Typography.ContextualAlternates="False"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                     InputMethod.IsInputMethodEnabled="False" AllowDrop="False"
                     AutomationProperties.Name="在这里输入" Language="en-US">
            </TextBox>
            <TextBlock x:Name="ReviewMeaning" Margin="0,8,0,0" Visibility="Collapsed"
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
            <TextBlock x:Name="PracticeResult" Margin="0,10,0,0" Visibility="Collapsed"
                       TextWrapping="Wrap" Foreground="{StaticResource Accent}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel x:Name="PracticeSidebar" Grid.Row="1" Margin="0,10,0,0">
      <Border x:Name="PracticeStatistics" Margin="0,0,0,10" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="8,8,5,8">
          <TextBlock x:Name="SpeedLabel" Text="速度 (WPM)" Style="{StaticResource StatLabel}" />
          <TextBlock x:Name="Speed" Style="{StaticResource StatValue}"
                     ToolTip="每 5 个正确字符折算为 1 个词。" />
        </StackPanel>
        <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0">
          <StackPanel Margin="8,8,5,8">
            <TextBlock Text="正确率" Style="{StaticResource StatLabel}" />
            <TextBlock x:Name="Accuracy" Style="{StaticResource StatValue}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Margin="8,8,5,8">
          <TextBlock Text="用时" Style="{StaticResource StatLabel}" />
          <TextBlock x:Name="Elapsed" Style="{StaticResource StatValue}" />
        </StackPanel>
      </Grid>
      </Border>

      <Border x:Name="PracticeRanking" Margin="0,0,0,10" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" Padding="16,9,16,10">
        <StackPanel>
          <DockPanel>
            <ComboBox x:Name="PracticeRankingOrder" DockPanel.Dock="Right" SelectedIndex="2" MinWidth="103"
                      MinHeight="28" Margin="8,0,0,0" AutomationProperties.Name="排行榜排序"
                      ToolTip="综合分 = 速度 × 准确率²">
              <ComboBoxItem Content="按速度" />
              <ComboBoxItem Content="按准确率" />
              <ComboBoxItem Content="加权综合" />
            </ComboBox>
            <TextBlock Text="本地排行榜" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="PracticeRankingTitle" Margin="0,5,0,0" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
          <TextBlock x:Name="PracticeRankingRows" Margin="0,5,0,0" Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap" LineHeight="24" />
        </StackPanel>
      </Border>

      <Border x:Name="PracticeMusic" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,9,16,10">
        <StackPanel>
          <WrapPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="背景音乐" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
              <CheckBox x:Name="PlayMusic" Content="练习时播放" Margin="13,0,0,0" />
            </StackPanel>
            <Button x:Name="ChooseFolder" Content="选择音乐文件夹"
                    Margin="8,0,0,0" Padding="9,5" VerticalAlignment="Center" />
          </WrapPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="曲目" Margin="0,0,8,0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" x:Name="NextTrack" Content="下一首" Margin="8,0,0,0"
                    ToolTip="下一首 (F8)" IsEnabled="False" />
            <Button DockPanel.Dock="Right" x:Name="ToggleMusic" Content="播放" MinWidth="64" Margin="8,0,0,0"
                    IsEnabled="False" />
            <ComboBox x:Name="MusicTrack" MinHeight="34" Padding="6,2" VerticalContentAlignment="Center"
                      SelectedValuePath="FullName" IsEnabled="False" MaxDropDownHeight="240"
                      AutomationProperties.Name="曲目" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
              <ComboBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ComboBox.ItemsPanel>
            </ComboBox>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock x:Name="MusicTime" DockPanel.Dock="Right" Text="0:00 / 0:00" Margin="10,0,0,0"
                       FontFamily="Consolas" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <Slider x:Name="MusicPosition" Minimum="0" Maximum="1" SmallChange="1" LargeChange="5"
                    IsEnabled="False" IsMoveToPointEnabled="True" AutomationProperties.Name="音乐播放进度" />
          </DockPanel>
          <WrapPanel Margin="0,8,0,0">
            <TextBlock Text="模式" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ComboBox x:Name="MusicMode" MinWidth="112" MinHeight="28" Padding="6,2"
                      VerticalContentAlignment="Center" AutomationProperties.Name="播放模式">
              <ComboBoxItem Content="顺序循环" />
              <ComboBoxItem Content="随机播放" />
              <ComboBoxItem Content="单曲循环" />
            </ComboBox>
            <TextBlock Text="音量" Margin="10,0,6,0" VerticalAlignment="Center" />
            <Slider x:Name="MusicVolume" Width="68" Minimum="0" Maximum="100"
                    SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" AutomationProperties.Name="音乐音量" />
            <TextBlock x:Name="VolumeLabel" Margin="5,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" />
          </WrapPanel>
          <TextBlock x:Name="MusicStatus" Foreground="{StaticResource Muted}" FontSize="13"
                     Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="SettingsNotice" Visibility="Collapsed" Margin="0,8,0,0"
                 Foreground="{StaticResource Coral}" Text="设置未能保存，下次打开时可能需要重新选择。" />
      </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>

  <Grid x:Name="SnakePage" Margin="30,19,30,22" MaxWidth="1200" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel x:Name="SnakeHeader" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" x:Name="CloseSnake" Content="返回短文"
              Margin="12,0,0,0" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" x:Name="OpenSnakeRules" Content="玩法规则" Style="{StaticResource PrimaryButton}"
              Margin="12,0,0,0" VerticalAlignment="Center" />
      <StackPanel>
        <Border Width="66" Height="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,4" />
        <TextBlock Text="贪吃蛇" Style="{StaticResource DisplayTitle}" />
        <TextBlock x:Name="SnakeCameraMode" Text="自由视角 · Alt 切换" Margin="0,3,0,0"
                   Foreground="{StaticResource Muted}" />
        <Border x:Name="SnakeTutorialBanner" Visibility="Collapsed" Margin="0,6,0,0" Padding="7,4"
                Background="{StaticResource Field}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
          <DockPanel>
            <Button x:Name="ExitSnakeTutorial" DockPanel.Dock="Right" Content="退出引导" Margin="8,0,0,0"
                    VerticalAlignment="Center" />
            <TextBlock x:Name="SnakeTutorialInstruction" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
        </Border>
      </StackPanel>
    </DockPanel>

    <Border x:Name="SnakeFrame" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" Padding="10">
      <Grid x:Name="SnakeLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0.67*" MinWidth="228" MaxWidth="318" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="SnakePlayArea">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel x:Name="SnakeOverview" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Border x:Name="SnakeMinimapHost" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" ClipToBounds="True" AutomationProperties.Name="全图与当前视野" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="小地图" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="SnakeOverviewSize" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,3" />
              <TextBlock Text="黄框视野 · 黄点自己" Foreground="{StaticResource Muted}" FontSize="11" />
              <TextBlock x:Name="SnakeCameraLookHint" Text="按住方向键查看" Visibility="Collapsed"
                         Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
              <TextBlock x:Name="SnakeObjectiveMapText" Visibility="Collapsed" Foreground="{StaticResource Accent}"
                         FontSize="11" TextWrapping="Wrap" MaxWidth="150" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="1" x:Name="SnakeBoardSlot" ClipToBounds="True">
          <Grid x:Name="SnakeSquare" HorizontalAlignment="Center" VerticalAlignment="Top">
          <Border x:Name="SnakeBoardHost" ClipToBounds="True" Background="{StaticResource Field}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1"
                  AutomationProperties.Name="贪吃蛇 32 × 32 视野" />
          <Border x:Name="SnakeWordFlash" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top"
                  HorizontalAlignment="Center" Margin="7,8,7,0" Padding="13,5,13,6"
                  Background="#F521343D" BorderBrush="{StaticResource Accent}" BorderThickness="1">
            <StackPanel>
              <Grid>
                <Grid.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="FontSize" Value="30" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextAlignment" Value="Center" />
                  </Style>
                </Grid.Resources>
                <TextBlock x:Name="SnakeFlashBlue" Foreground="#5DB5D4" Opacity="0.72">
                  <TextBlock.RenderTransform><TranslateTransform X="-2" Y="1" /></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="SnakeFlashRose" Foreground="#D285AF" Opacity="0.67">
                  <TextBlock.RenderTransform><TranslateTransform X="2" Y="-1" /></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="SnakeFlashWord" Foreground="{StaticResource Accent}" />
              </Grid>
              <TextBlock x:Name="SnakeFlashMeaning" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Border>
          </Grid>
          </Grid>
          <Border Grid.RowSpan="2" x:Name="LanPanel" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="16">
                <TextBlock Text="局域网房间" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="同一 Wi-Fi 或有线网络，最多 4 人。" Margin="0,4,0,12"
                           TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                <TextBlock Text="你的昵称" FontWeight="SemiBold" />
                <TextBox x:Name="LanName" Margin="0,4,0,10" MaxLength="20" MinHeight="30" Padding="5,3"
                         AutomationProperties.Name="你的昵称" />
                <TextBlock Text="房间名" FontWeight="SemiBold" />
                <TextBox x:Name="LanRoomName" Margin="0,4,0,8" MaxLength="24" MinHeight="30" Padding="5,3"
                         AutomationProperties.Name="房间名" />
                <Button x:Name="LanCreate" Content="创建房间" HorizontalAlignment="Left" />
                <DockPanel Margin="0,14,0,6" LastChildFill="False">
                  <TextBlock Text="附近的房间" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <Button DockPanel.Dock="Right" x:Name="LanScan" Content="扫描房间" />
                </DockPanel>
                <ListBox x:Name="LanRooms" Height="86" BorderBrush="{StaticResource Line}"
                         AutomationProperties.Name="附近的房间" />
                <TextBlock Text="房主 IPv4（扫描不到时）" Margin="0,10,0,4"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                <TextBox x:Name="LanAddress" MaxLength="15" MinHeight="30" Padding="5,3"
                         AutomationProperties.Name="房主 IPv4" />
                <Button x:Name="LanJoin" Content="加入房间" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Style="{StaticResource PrimaryButton}" />
                <TextBlock x:Name="LanNotice" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource Muted}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <DockPanel x:Name="SnakeControls" Grid.Column="1" Margin="12,0,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
            <TextBlock Text="输入指令" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <TextBox x:Name="SnakeCommand" MinHeight="35" Padding="6,3" FontFamily="Consolas"
                     FontSize="19" MaxLength="10" AcceptsReturn="False" SpellCheck.IsEnabled="False"
                     InputMethod.IsInputMethodEnabled="False" AllowDrop="False"
                     AutomationProperties.Name="输入开始或方向词" />
            <StackPanel x:Name="SnakeChargePanel" Visibility="Collapsed" Margin="0,5,0,0">
              <TextBlock x:Name="SnakeChargeWord" TextWrapping="Wrap" Foreground="#9DE4EB" FontWeight="SemiBold" />
              <TextBox x:Name="SnakeChargeInput" MinHeight="31" Padding="6,2" Margin="0,3,0,0"
                       FontFamily="Consolas" FontSize="16" MaxLength="20" SpellCheck.IsEnabled="False"
                       InputMethod.IsInputMethodEnabled="False" AllowDrop="False"
                       AutomationProperties.Name="职业技能输入框" />
            </StackPanel>
          </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <TextBlock Text="对局控制" Style="{StaticResource SectionTitle}" />
              <TextBlock DockPanel.Dock="Right" x:Name="SnakeBoardSize" Text="32 × 32 格" Foreground="{StaticResource Muted}" />
            </DockPanel>
            <StackPanel x:Name="SnakeSetup">
            <DockPanel Margin="0,8,0,0">
              <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,9,0" FontWeight="SemiBold" />
              <ComboBox x:Name="SnakeMode" SelectedIndex="0" MinHeight="27"
                        AutomationProperties.Name="贪吃蛇玩法">
                <ComboBoxItem Content="经典" />
                <ComboBoxItem Content="障碍赛" />
                <ComboBoxItem Content="圈地战" />
                <ComboBoxItem Content="团战" />
                <ComboBoxItem Content="镜像竞速" />
                <ComboBoxItem Content="四区供电" />
                <ComboBoxItem Content="热点争夺" />
                <ComboBoxItem Content="词牌接力" />
              </ComboBox>
            </DockPanel>
            <DockPanel x:Name="SoloMapControls" Margin="0,5,0,0">
              <TextBlock Text="地图边长" VerticalAlignment="Center" Margin="0,0,9,0" />
              <TextBlock x:Name="SoloMapValue" Text="32" DockPanel.Dock="Right" Margin="8,0,0,0"
                         Width="27" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
              <Slider x:Name="SoloMapSize" Value="32" Minimum="32" Maximum="128" TickFrequency="1"
                      SmallChange="1" LargeChange="8" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      AutomationProperties.Name="单人经典模式地图边长" />
            </DockPanel>
            <CheckBox x:Name="LanUniformRaceRole" Visibility="Collapsed" Content="统一使用房主职业" Margin="0,6,0,0" />
            <StackPanel x:Name="SnakeBotSettings" Margin="0,6,0,0">
              <DockPanel>
                <TextBlock Text="人机数量" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ComboBox x:Name="SnakeBotCount" SelectedIndex="0" MinHeight="27" AutomationProperties.Name="人机数量">
                  <ComboBoxItem Content="不添加" /><ComboBoxItem Content="1 个" /><ComboBoxItem Content="2 个" /><ComboBoxItem Content="3 个" />
                </ComboBox>
              </DockPanel>
              <DockPanel Margin="0,5,0,0">
                <TextBlock Text="人机强度" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ComboBox x:Name="SnakeBotDifficulty" SelectedIndex="1" MinHeight="27" AutomationProperties.Name="人机强度">
                  <ComboBoxItem Content="简单" /><ComboBoxItem Content="普通" /><ComboBoxItem Content="困难" /><ComboBoxItem Content="地狱" />
                </ComboBox>
              </DockPanel>
            </StackPanel>
            <DockPanel Margin="0,5,0,0">
              <TextBlock x:Name="LanTeamsLabel" Visibility="Collapsed" Text="队伍数量" VerticalAlignment="Center"
                         Margin="0,0,9,0" FontWeight="SemiBold" />
              <ComboBox x:Name="LanTeamCount" Visibility="Collapsed" SelectedIndex="0" MinHeight="27"
                        AutomationProperties.Name="团战队伍数量">
                <ComboBoxItem Content="2 队" />
                <ComboBoxItem Content="3 队" />
                <ComboBoxItem Content="4 队" />
              </ComboBox>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
              <TextBlock Text="职业" VerticalAlignment="Center" Margin="0,0,9,0" FontWeight="SemiBold" />
              <ComboBox x:Name="SnakeRole" SelectedIndex="0" MinHeight="27"
                        AutomationProperties.Name="贪吃蛇职业">
                <ComboBoxItem Content="平凡者" />
                <ComboBoxItem Content="时空者" />
                <ComboBoxItem Content="胆怯者" />
                <ComboBoxItem Content="无畏者" />
                <ComboBoxItem Content="狩猎者" />
                <ComboBoxItem Content="吟唱者" />
                <ComboBoxItem Content="领航者" />
                <ComboBoxItem Content="采集者" />
                <ComboBoxItem Content="稳行者" />
              </ComboBox>
            </DockPanel>
            <TextBlock x:Name="SnakeRoleGuide" Foreground="{StaticResource Muted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,0,1" />
            </StackPanel>
            <Grid>
              <Grid.Resources>
                <Style x:Key="DirectionWord" TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="Consolas" />
                  <Setter Property="FontSize" Value="13" />
                  <Setter Property="FontWeight" Value="Bold" />
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="DirectionName" TargetType="TextBlock">
                  <Setter Property="FontSize" Value="13" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="{StaticResource Accent}" />
                  <Setter Property="Margin" Value="0,0,0,3" />
                </Style>
                <Style x:Key="DirectionCard" TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource Field}" />
                  <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="Padding" Value="7,4" />
                  <Setter Property="Margin" Value="3" />
                </Style>
              </Grid.Resources>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource DirectionCard}">
                <StackPanel>
                  <TextBlock Text="↑ 上" Style="{StaticResource DirectionName}" />
                  <TextBlock x:Name="SnakeNorth" Style="{StaticResource DirectionWord}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DirectionCard}">
                <StackPanel>
                  <TextBlock Text="← 左" Style="{StaticResource DirectionName}" />
                  <TextBlock x:Name="SnakeWest" Style="{StaticResource DirectionWord}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource DirectionCard}">
                <StackPanel>
                  <TextBlock Text="右 →" Style="{StaticResource DirectionName}" />
                  <TextBlock x:Name="SnakeEast" Style="{StaticResource DirectionWord}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource DirectionCard}">
                <StackPanel>
                  <TextBlock Text="↓ 下" Style="{StaticResource DirectionName}" />
                  <TextBlock x:Name="SnakeSouth" Style="{StaticResource DirectionWord}" />
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock Text="— 当前方向   × 禁止掉头" Foreground="{StaticResource Muted}"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <Border Margin="0,7,0,9" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0"
                    Background="{StaticResource Field}" Padding="9,2,8,3">
            <DockPanel LastChildFill="False">
              <TextBlock x:Name="SnakeScoreLabel" Text="分数" VerticalAlignment="Center"
                         Foreground="{StaticResource Muted}" FontSize="12" />
              <TextBlock DockPanel.Dock="Right" x:Name="SnakeScore" Text="0" FontFamily="Consolas"
                         FontSize="27" FontWeight="Bold" Foreground="{StaticResource Accent}" />
            </DockPanel>
            </Border>
            <TextBlock x:Name="SnakeScoreGuide" Text="有效转向 +6 或 +7 · 吃果 +10" Foreground="{StaticResource Muted}"
                       FontSize="12" Margin="0,-3,0,9" />
            <TextBlock x:Name="SnakeFruitLegend" Foreground="{StaticResource Muted}" FontSize="12"
                       Margin="0,-4,0,9" Visibility="Collapsed">
              <Run Foreground="{StaticResource Coral}" Text="■" /><Run x:Name="SnakeSmallFruitLegend" Text=" 小果 +10　" />
              <Run Foreground="#FFD48C" Text="■" /><Run x:Name="SnakeLargeFruitLegend" Text=" 大果 +30" />
            </TextBlock>

            <TextBlock x:Name="SnakeStatus" Text="输入 start 开始单人游戏。" Margin="0,6,0,0"
                       MinHeight="36" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="LanToggle" Content="局域网联机" />
              <CheckBox x:Name="SnakeVoiceEnabled" Content="英文女声" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="念出你完成的有效方向词和技能词。" />
              <CheckBox x:Name="SnakeLowEffects" Content="低特效" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="减弱震动和动画，保留子弹与技能范围提示。" />
              <CheckBox x:Name="SnakeMusicEnabled" Content="单人配乐" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="对局中循环播放内置配乐，音量使用打字页的音乐音量。" />
            </WrapPanel>
            <Expander x:Name="SnakeRecap" Header="本局复盘" Visibility="Collapsed" Margin="0,5,0,0">
              <TextBlock x:Name="SnakeRecapText" TextWrapping="Wrap" Margin="0,4,0,4" />
            </Expander>
            <TextBlock x:Name="LanRoster" Margin="0,6,0,6" TextWrapping="Wrap" LineHeight="22"
                       Foreground="{StaticResource Muted}" Visibility="Collapsed" />
            <Expander x:Name="LanAudioControls" Header="房间音量" Visibility="Collapsed" Margin="0,3,0,8">
              <StackPanel Margin="0,5,0,0">
                <TextBlock x:Name="LanMusicStatus" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                <DockPanel x:Name="LanMasterControl" Margin="0,4,0,0">
                  <TextBlock Text="全房音乐" Width="70" VerticalAlignment="Center" />
                  <TextBlock x:Name="LanMasterLevel" DockPanel.Dock="Right" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                  <Slider x:Name="LanMasterVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          AutomationProperties.Name="全房音乐音量" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="我的音乐" Width="70" VerticalAlignment="Center" />
                  <TextBlock x:Name="LanMusicLevel" DockPanel.Dock="Right" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                  <Slider x:Name="LanMusicVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          AutomationProperties.Name="个人背景音乐音量" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="我的音效" Width="70" VerticalAlignment="Center" />
                  <TextBlock x:Name="LanEffectsLevel" DockPanel.Dock="Right" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                  <Slider x:Name="LanEffectsVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          AutomationProperties.Name="个人游戏音效音量" />
                </DockPanel>
              </StackPanel>
            </Expander>
            <Button x:Name="LanLeave" Content="离开房间" HorizontalAlignment="Left" Visibility="Collapsed" />
            <Button x:Name="LanReady" Content="准备" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,6,0,0" />
            <TextBlock x:Name="LanRules" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       FontSize="12" Visibility="Collapsed" Margin="0,5,0,0" />
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>

  <Grid x:Name="SnakeRules" Visibility="Collapsed" MaxWidth="850" Margin="28,19,28,20">
    <Grid.Resources>
      <Style x:Key="RuleHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,14,0,6" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
      </Style>
      <Style x:Key="RuleText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel x:Name="RulesHeader" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" x:Name="CloseSnakeRules" Content="返回棋盘" Margin="12,0,0,0" VerticalAlignment="Center" />
      <StackPanel>
        <Border Width="66" Height="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,4" />
        <TextBlock Text="玩法规则" Style="{StaticResource DisplayTitle}" />
      </StackPanel>
    </DockPanel>
    <Border x:Name="RulesFrame" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <ScrollViewer x:Name="SnakeRulesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,5,20,16">
          <TextBlock Text="跟着棋盘练一遍" Style="{StaticResource RuleHeading}" />
          <TextBlock Text="练习打词转向、切换视角和清空输入，再体验所选职业。引导会在每步操作之间暂停。"
                     Style="{StaticResource RuleText}" />
          <WrapPanel Margin="0,0,0,4">
            <ComboBox x:Name="SnakeTutorialRole" MinWidth="130" Margin="0,0,8,4"
                      AutomationProperties.Name="引导练习职业" />
            <Button x:Name="StartSnakeTutorial" Content="开始引导" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" />
          </WrapPanel>
          <TextBlock x:Name="SnakeTutorialNotice" TextWrapping="Wrap" Foreground="{StaticResource Coral}" />
          <TextBlock Text="快速开局" Style="{StaticResource RuleHeading}" />
          <TextBlock Style="{StaticResource RuleText}">
            <Run Text="1. 先选模式和职业。单人直接输入 " /><Run Text="start" FontFamily="Consolas" FontWeight="Bold" /><Run Text="。联机时，房主建房，同一网络的朋友扫描加入，再由房主开局。" />
          </TextBlock>
          <TextBlock Style="{StaticResource RuleText}">
            <Run Text="2. 蛇会一直前进。照着十字面板打完目标方向的英文词，蛇就会转向。× 表示禁止掉头。按空格清空当前输入框。" />
          </TextBlock>
          <TextBlock Style="{StaticResource RuleText}">
            <Run Text="3. 有技能的职业按 Tab 切换输入框。技能短语连写。蛇头气泡显示正在输入的字母，联机时也显示昵称。" />
          </TextBlock>

          <TextBlock Text="八种玩法" Style="{StaticResource RuleHeading}" />
          <TextBlock Style="{StaticResource RuleText}"><Run Text="经典　" FontWeight="Bold" /><Run Text="打方向词和吃果都得分。单人开局前可调地图边长。每分钟缩小 5 格，圈外视为撞墙。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}" Text="主棋盘显示 32 × 32 格。按 Alt 切换自由和锁定视角。锁定时蛇头居中，按住方向键可查看周围，松开回到蛇头。小地图黄框标出视野覆盖的地图范围，黄点标出自己。棋盘上的橙色箭头指向大果。" />
          <TextBlock Style="{StaticResource RuleText}"><Run Text="障碍赛　" FontWeight="Bold" /><Run Text="开局随机生成四格方块障碍，绕开障碍去吃果。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="圈地战　" FontWeight="Bold" /><Run Text="走回自己的轨迹闭合圈地。对手蛇头被圈住就回出生点。每分钟提速 20%，5 分钟后占地最多者获胜。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="团战　" FontWeight="Bold" /><Run Text="仅限联机，房主选 2–4 队。可穿过己方球，碰到敌队球会捡起。带球回己方区域按 Shift 放下一颗，每带一颗球扣 10% 移速。空手按住 Shift 提速 25%。死亡后等 15 秒复活，8 分钟后按落地球数排名。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="镜像竞速　" FontWeight="Bold" /><Run Text="单人计时或 2–4 人联机。同一场比赛各自跑同一张地图，按顺序经过 6 个检查点。撞车回到最近通过的检查点，计时加 5 秒。3 分钟内先比完赛用时，未完赛先比检查点数，再比到达最后一站的用时。单人在固定赛道按职业保存最佳成绩。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="四区供电　" FontWeight="Bold" /><Run Text="2–4 人联机合作。蛇头在 5×5 供电区内时，完成一次转向可充 1 格。每 45 秒停用一座站 10 秒，提前 5 秒提示。队友可以互相穿过，撞车后 5 秒复活。5 分钟内充满四座站即可通关。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="热点争夺　" FontWeight="Bold" /><Run Text="2–4 人争夺 7×7 热点。独占时每秒加 1 分，多人同在时暂停计分。热点每 30 秒更换，提前 5 秒预告。撞车 5 秒后复活，4 分钟后按热点积分排名。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="词牌接力　" FontWeight="Bold" /><Run Text="4 人分成两队，各队在独立赛道跑四棒。前一棒到交接区后，队友打完接力词才出发。撞车等 5 秒回本棒起点。先完成四棒的队伍获胜。4 分钟内都未完赛时，先比完成棒数，再比最近一次到达交接区的时间。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}" Text="单人和局域网房主均可添加人机，选择简单、普通、困难或地狱。人机占用普通玩家席位。对战中蛇头相撞，双方同时出局。" />

          <TextBlock Text="九个职业" Style="{StaticResource RuleHeading}" />
          <TextBlock Style="{StaticResource RuleText}"><Run Text="平凡者　" FontWeight="Bold" /><Run Text="基础移速，使用 6–7 字母方向词。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="胆怯者　" FontWeight="Bold" /><Run Text="85% 移速，使用 5–6 字母方向词。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="时空者　" FontWeight="Bold" /><Run Text="每个可用方向有 6、8、10 字母词。经典和障碍赛分别额外前进 0、1、2 格，每次转向加 6 分。最长词可沿当前方向加速，直行加速不计分。圈地战和团战的额外位移为 0、2、4 格。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="无畏者　" FontWeight="Bold" /><Run Text="圈地战的基础移速为 100%，其余模式为 120%。打完技能词后冲锋 1 秒，穿过对手会使其僵直 3 秒。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="狩猎者　" FontWeight="Bold" /><Run Text="打完技能词后朝前射击，子弹速度为自身移速 3 倍，碰到对手蛇身即命中。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="吟唱者　" FontWeight="Bold" /><Run Text="打完技能词后，瞬间命中以蛇头为中心 5×5 格内的对手蛇头。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="领航者　" FontWeight="Bold" /><Run Text="方向词通常为 7–8 字母。完成 3 个常规方向词后，下个方向词缩短到 4 字母。圈地战改用 6–7 字母常规词和 5 字母短词。经典和障碍赛转向固定加 6 分。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="采集者　" FontWeight="Bold" /><Run Text="经典和障碍赛转向加 5 分，小果加 14 分，大果加 38 分。团战每携带一颗球扣 8% 移速。" /></TextBlock>
          <TextBlock Style="{StaticResource RuleText}"><Run Text="稳行者　" FontWeight="Bold" /><Run Text="按 Tab 输入 9–11 字母的技能词，2.5 秒内以 70% 移速前进，期间可打词转向。经典技能加 5 分，障碍赛加 8 分。圈地战以 85% 移速稳行 1.5 秒，发动后冷却 40 秒。" /></TextBlock>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="650" Margin="28,18,28,18">
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" x:Name="CloseSettings" Content="返回练习" Margin="12,0,0,0"
                VerticalAlignment="Center" />
        <StackPanel>
          <Border Width="62" Height="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
          <TextBlock Text="外观设置" Style="{StaticResource DisplayTitle}" Margin="0,5,0,0" />
        </StackPanel>
      </DockPanel>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="13">
        <StackPanel>
          <TextBlock Text="界面风格" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
          <UniformGrid Columns="2">
          <RadioButton x:Name="ThemeModern" GroupName="Theme" Padding="8,6" Margin="0,0,5,6">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#263946" BorderBrush="#EEF767" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="现代" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeMinimal" GroupName="Theme" Padding="8,6" Margin="5,0,0,6">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#F0EEE7" BorderBrush="#557469" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="极简" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeCyberpunk" GroupName="Theme" Padding="8,6" Margin="0,0,5,6">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#261735" BorderBrush="#52F2E8" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="赛博朋克" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeSteampunk" GroupName="Theme" Padding="8,6" Margin="5,0,0,6">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#412F23" BorderBrush="#E0B36E" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="蒸汽朋克" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeVaporwave" GroupName="Theme" Padding="8,6" Margin="0,0,5,6">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#F8A9DE" BorderBrush="#67D4CD" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="蒸汽波" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeConstructivist" GroupName="Theme" Padding="8,6" Margin="5,0,0,6">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#DBC8AC" BorderBrush="#A72722" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="构成主义" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemePersona5" GroupName="Theme" Padding="8,6" Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#1C121A" BorderBrush="#F62845" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="P5 风格" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeChineseStyle" GroupName="Theme" Padding="8,6" Margin="5,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="27" Height="19" Background="#EEF0D8" BorderBrush="#57796F" BorderThickness="2" Margin="0,0,9,0" />
              <TextBlock Text="国风" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          </UniformGrid>
        </StackPanel>
      </Border>
      <DockPanel Margin="0,8,0,0">
        <Button x:Name="RestartWithTheme" DockPanel.Dock="Right" Content="保存并重启" IsEnabled="False"
                Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Center" />
        <TextBlock x:Name="ThemeStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </ScrollViewer>

  <Grid x:Name="PracticeRecordOverlay" Panel.ZIndex="15" Background="#CE091218" Visibility="Collapsed"
        KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="打字新纪录">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="330" Padding="22,18"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
      <StackPanel>
        <Border Width="58" Height="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
        <TextBlock Text="恭喜，刷新纪录！" Style="{StaticResource DisplayTitle}" FontSize="30" Margin="0,9,0,8" />
        <TextBlock x:Name="PracticeRecordDetails" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
        <Button x:Name="DismissPracticeRecord" Content="确定" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" MinWidth="78" Margin="0,15,0,0" />
      </StackPanel>
    </Border>
  </Grid>

  <Grid x:Name="StartupOverlay" Panel.ZIndex="20" Background="#0B141B" ClipToBounds="True" Focusable="True" Visibility="Collapsed"
        KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="鼎山打字通启动界面">
    <Grid.Resources>
      <Style x:Key="StartupButtonFocus">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border BorderBrush="{StaticResource Ink}" BorderThickness="1" Margin="3" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid x:Name="StartupPanels" Opacity="0" IsHitTestVisible="False">
      <Border Background="{StaticResource Backplate}" />
      <Border Background="{StaticResource GuideGrid}" Opacity=".78" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width=".8*" /><ColumnDefinition Width="1.9*" />
          <ColumnDefinition Width="1.1*" /><ColumnDefinition Width=".3*" />
        </Grid.ColumnDefinitions>
        <Border Background="#224D727D" BorderBrush="#495E8C97" BorderThickness="0,0,1,0" />
        <Border Grid.Column="2" Background="#154D727D" BorderBrush="#495E8C97" BorderThickness="1,0,1,0" />
        <Border Grid.Column="3" Background="#245A7B86" BorderBrush="#315E8C97" BorderThickness="1,0,0,0" Margin="5,0,0,0" />
      </Grid>
      <Border x:Name="StartupPattern" Background="{StaticResource Halftone}" Height="124" VerticalAlignment="Top" Opacity=".27">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="Black" Offset="0" /><GradientStop Color="Transparent" Offset="1" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
      <Border x:Name="StartupScanBeam" VerticalAlignment="Center" Height="55" Opacity="0">
        <Border.RenderTransform><TranslateTransform x:Name="StartupScan" /></Border.RenderTransform>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="Transparent" Offset="0" />
            <GradientStop Color="#1259A4B4" Offset=".84" />
            <GradientStop Color="#A3ECF664" Offset=".98" />
            <GradientStop Color="Transparent" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid Margin="27,20,27,19">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
          <Border Width="38" Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
          <TextBlock Text="鼎山打字通" FontWeight="SemiBold" FontSize="16" Margin="0,5,0,0" />
        </StackPanel>
        <Border Height="1" Background="#735F8890" VerticalAlignment="Bottom" />
        <Border Width="51" Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
      </Grid>
    </Grid>

    <StackPanel x:Name="StartupBrand" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <Image x:Name="StartupIcon" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,12" />
      <TextBlock Text="鼎山打字通" Style="{StaticResource DisplayTitle}" FontSize="31" TextAlignment="Center" />
    </StackPanel>

    <Border x:Name="StartupForm" Width="386" HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="0,15,0,0" Padding="22,16,22,19" BorderThickness="2,1,1,1"
            BorderBrush="{StaticResource Line}" Background="#F015232B" Opacity="0" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="StartupTitle" Text="注册本地账号" Style="{StaticResource DisplayTitle}" FontSize="27" />
        <TextBlock x:Name="StartupHint" Text="设置一个昵称，联机时会自动填入。" Foreground="{StaticResource Muted}"
                   FontSize="13" TextWrapping="Wrap" Margin="0,5,0,15" />
        <TextBlock x:Name="StartupNicknameLabel" Text="联机昵称" Foreground="{StaticResource Accent}"
                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBox x:Name="StartupNickname" MinHeight="40" Padding="9,5" FontSize="17" MaxLength="20"
                 VerticalContentAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=StartupNicknameLabel}" />
        <TextBlock x:Name="StartupSavedName" Visibility="Collapsed" TextWrapping="Wrap" FontSize="19" FontWeight="SemiBold"
                   Foreground="{StaticResource Accent}" Margin="0,0,0,2" />
        <TextBlock x:Name="StartupError" Foreground="{StaticResource Coral}" FontSize="12" TextWrapping="Wrap"
                   MinHeight="16" Margin="0,6,0,0" Visibility="Hidden" />
        <Button x:Name="StartupConfirm" Content="注册" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" IsDefault="True"
                FocusVisualStyle="{StaticResource StartupButtonFocus}" Margin="0,14,0,0" MinWidth="126" MinHeight="37" />
      </StackPanel>
    </Border>

    <Grid x:Name="StartupOrbit" Width="234" Height="234" HorizontalAlignment="Center" VerticalAlignment="Center"
          Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
      <Ellipse Margin="22" Stroke="#4989B0B5" StrokeThickness="1" />
      <Ellipse Margin="41" Stroke="#387DAAB2" StrokeThickness="1" StrokeDashArray="2,5" />
      <Grid RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><RotateTransform x:Name="StartupOrbitRotation" /></Grid.RenderTransform>
        <Path Stroke="{StaticResource Accent}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M117,14 A103,103 0 1 1 23,159" />
        <Path Stroke="#B4A8D5D9" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M167,73 A66,66 0 1 1 57,92" />
        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="114,11,0,0" />
        <Ellipse Width="4" Height="4" Fill="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="172,176,0,0" />
      </Grid>
      <TextBlock x:Name="StartupOrbitText" Text="准备就绪" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="133" FontSize="17" FontWeight="SemiBold" />
    </Grid>

    <Button x:Name="StartupSkip" Content="跳过动画" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0"
            MinHeight="29" Padding="8,4" FontSize="12" Background="#193242" BorderBrush="{StaticResource Line}" />
  </Grid>
  </Grid>
</Window>
